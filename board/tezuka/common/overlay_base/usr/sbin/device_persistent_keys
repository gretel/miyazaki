#!/bin/sh
# Persist SSH host keys and authorized_keys to JFFS2.
# Keys are restored at boot by S21misc.
set -e

if ! mount | grep -q mtd2; then
    echo "JFFS2 not mounted — run device_format_jffs2 first"
    exit 1
fi

mkdir -p /mnt/jffs2/etc/ssh

# Copy host keys
count=0
for key in /etc/ssh/ssh_host_*; do
    [ -f "$key" ] || continue
    cp "$key" /mnt/jffs2/etc/ssh/
    count=$((count + 1))
    echo "Saved $(basename "$key")"
done

if [ "$count" -eq 0 ]; then
    echo "No host keys found in /etc/ssh/ — sshd may not have generated them yet"
    exit 1
fi

# Copy authorized_keys if present
if [ -f /root/.ssh/authorized_keys ]; then
    cp /root/.ssh/authorized_keys /mnt/jffs2/etc/ssh/authorized_keys
    echo "Saved authorized_keys"
fi

sync
echo "Done. Keys will be restored from JFFS2 on next boot."
